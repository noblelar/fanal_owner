# This API base URL points the owner app at the platform backend.
FANAL_OWNER_API_BASE_URL=http://localhost:8081

# This secret signs the owner app's httpOnly session cookie.
JWT_SECRET=replace_with_a_long_random_secret

# Set this to false only when the owner app is temporarily served over plain HTTP.
COOKIE_SECURE=true

# Cloudinary secure upload configuration for documentation images.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_BASE_FOLDER=fanal_dev

# Read-only Release Center catalog. Use a GitHub App with Metadata: read and
# Actions: read access to noblelar/fanalAPI, noblelar/fanal_main, and
# noblelar/fanal_owner. Keep the PEM private key in a mounted secret file.
GITHUB_CATALOG_APP_ID=123456
GITHUB_CATALOG_INSTALLATION_ID=12345678
# Compose reads this host path; it is never baked into the Owner image.
GITHUB_CATALOG_PRIVATE_KEY_HOST_FILE=/etc/fanal/secrets/github_catalog_app_private_key.pem
# The Owner process reads the mounted Docker secret at this container path.
GITHUB_CATALOG_PRIVATE_KEY_FILE=/run/secrets/github_catalog_app_private_key.pem
GITHUB_CATALOG_CACHE_SECONDS=60
GITHUB_CATALOG_MAX_CANDIDATES=10

# This local port keeps the owner app separate from the main frontend during development.
PORT=3001
