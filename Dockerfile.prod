ARG APP_VERSION
ARG GIT_SHA

FROM node:20-alpine AS builder
WORKDIR /app

ARG APP_VERSION
ARG GIT_SHA

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV APP_VERSION=$APP_VERSION
ENV GIT_SHA=$GIT_SHA
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ARG APP_VERSION
ARG GIT_SHA

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
ENV APP_VERSION=$APP_VERSION
ENV GIT_SHA=$GIT_SHA

LABEL org.opencontainers.image.title="Fanal Owner" \
      org.opencontainers.image.source="https://github.com/noblelar/fanal_owner" \
      org.opencontainers.image.version="$APP_VERSION" \
      org.opencontainers.image.revision="$GIT_SHA"

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/build ./build
COPY --from=builder /app/public ./public
COPY --from=builder /app/scripts ./scripts

EXPOSE 3001

CMD ["npm", "run", "start"]
